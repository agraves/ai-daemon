# The privileged half: it sees every prompt on this machine and has no network.
#
# Every hardening line below is load-bearing rather than decorative, so each
# one says why it is here. Two of them are the design (§4, §9) and the rest are
# the ordinary minimum for a system service that parses input from every
# unprivileged process on the box.

[Unit]
Description=AI inference service
Documentation=man:ai-daemon(8) https://github.com/agraves/ai-daemon
# Bus-activated. Starting it at boot would hold a GPU context for a desktop
# that has not asked anything yet.
After=dbus.service
Requires=dbus.service

[Service]
Type=dbus
BusName=io.github.agraves.AIDaemon1
ExecStart=/usr/bin/ai-daemon
Restart=on-failure
RestartSec=2

# A stable uid, because the model store is owned by it. DynamicUser would mean
# re-chowning gigabytes on every restart, or losing them.
User=ai-daemon
Group=ai-daemon
DynamicUser=no
# The outer gate (§4): membership in `ai` decides which humans may talk to the
# daemon at all. It answers nothing about *which app* — that is the policy
# engine's job — and it is here so the two are not confused.
SupplementaryGroups=ai

# The load-bearing privacy claim (§9). The process that touches prompts cannot
# reach a network; downloads happen in ai-daemon-fetch@.service, which can, and
# which never sees a prompt. This is not configurable off, and the daemon's own
# installer path depends on it being true.
PrivateNetwork=yes
IPAddressDeny=any
#
# The two exceptions below are loopback inside this namespace and nothing else,
# and they are what makes the reference backend able to run at all. Backends are
# children of this unit and inherit its sandbox, and ai-daemon-backend-llamacpp
# drives llama-server over TCP loopback — it spawns the server on 127.0.0.1 and
# speaks HTTP to it, because that is llama.cpp's only interface.
#
# Without AF_INET every TcpListener::bind in the backend's port scan returns
# EAFNOSUPPORT, all sixty-four candidates "fail", and the user is told
# "no free loopback port for llama-server" — which reads as port exhaustion and
# sends them looking in the wrong place entirely.
#
# IPAddressAllow is the second half and easy to miss, because it fails in a
# quieter way: IPAddressDeny is a BPF cgroup filter that covers loopback too,
# so with AF_INET alone llama-server binds, logs "listening on 127.0.0.1:…",
# and the backend's request is dropped on the way. The session then hangs until
# backend_silence_seconds — fifteen minutes of nothing, for a working server.
#
# Neither line weakens §9. PrivateNetwork=yes means this namespace has one
# interface, lo, with no route anywhere; localhost here is the daemon and its
# own children talking to each other. Every address that is not loopback stays
# denied by the line above.
IPAddressAllow=localhost
RestrictAddressFamilies=AF_UNIX AF_INET

NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
StateDirectory=ai-daemon
RuntimeDirectory=ai-daemon
ConfigurationDirectory=ai-daemon
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectProc=default
ProcSubset=all
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

# The one line here that loosens rather than tightens, so it owes the longest
# explanation. Backends are this unit's children and inherit its seccomp
# filter, and GPU userspace generates code at runtime: Mesa compiles shaders,
# and the CUDA and ROCm stacks JIT. Denying write-execute would break every
# accelerated backend, and the only way to keep the restriction would be to put
# backends in their own units — which is a real design, and a bigger one than a
# line in this file.
#
# What limits the damage is that it is scoped to this unit rather than granted
# generally: ai-daemon-shim.service, which is the least trusted code in the
# project and touches no GPU, sets it to yes.
MemoryDenyWriteExecute=no
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

# Accelerators, and nothing else. A backend that claims a device outside these
# is refused at hello time rather than discovering it cannot open one later.
PrivateDevices=yes
DeviceAllow=/dev/dri rw
DeviceAllow=char-drm rw
DeviceAllow=char-accel rw

# ProtectProc=default rather than invisible: identifying a caller means reading
# /proc/<pid>/cgroup for processes owned by other users (§5), which is
# world-readable and is what the identity actually rests on. The exe read
# beside it needs ptrace-level access and so returns nothing for anybody else's
# process — see identity.rs, which says the same thing from the other side.
# Hiding /proc would take the cgroup too, and every native identity would
# collapse to "uid:N".

# No [Install] section, deliberately.
#
# This unit is D-Bus activated: dbus-1/system-services starts it on first use,
# which is the whole point of a service that should not be holding a GPU
# context for a desktop nobody has asked anything yet. There is nothing to
# enable, so there is no WantedBy.
#
# It previously carried "Also=ai-daemon.socket", naming a unit that has never
# existed in this repository — nothing in the daemon listens on a socket, since
# sessions arrive as descriptors passed over D-Bus. systemd refuses to enable a
# unit whose Also= target is missing, so the one command an admin reflexively
# runs failed pointing at a file that was never shipped.
