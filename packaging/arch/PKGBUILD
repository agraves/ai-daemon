# Maintainer: Aaron Graves <aaron.graves@gmail.com>
#
# Omarchy is Arch underneath, so the package format that runs there is this
# one. Build it with ../../packaging/arch/make-package.sh, which assembles the
# source tarball this expects; `makepkg` on its own has nothing to fetch.

pkgname=ai-daemon
pkgver=1.0.0
pkgrel=1
pkgdesc='System inference service for desktop Linux: D-Bus control plane, per-session data plane, per-app policy'
arch=('x86_64' 'aarch64')
url='https://github.com/agraves/ai-daemon'
license=('Apache-2.0')
# curl is the fetch helper's transport: TLS belongs to something the distro
# already audits rather than to a stack this project would have to keep up
# with. dbus and polkit are the control plane and the consent path.
depends=('dbus' 'curl' 'polkit')
makedepends=('rust' 'cargo')
# The reference backend drives llama-server when it is there, and declares no
# capabilities when it is not, so the daemon routes around it. Not a hard
# dependency: an install with only the conformance backend is a legitimate one.
#
# The package is `llama-cpp`, with a hyphen. This list said `llama.cpp` for the
# upstream project's name, which is not a package on this distro and so was a
# hint that installed nothing when followed.
#
# Arch also splits the compute backends out of `ggml`, which ships only
# libggml.so and libggml-base.so — no kernels. Installing llama-cpp alone gets
# a llama-server that dies at load with "no backends are loaded", before the
# daemon is involved at all, so the backend gets blamed for a missing package.
# One of the ggml-* below is required for llama-cpp to do anything; pick the
# one that matches the hardware.
optdepends=(
  'llama-cpp: GGUF inference via the llamacpp backend'
  'ggml-cpu: CPU kernels for llama-cpp (the baseline choice)'
  'ggml-cuda: NVIDIA kernels for llama-cpp'
  'ggml-hip: AMD ROCm kernels for llama-cpp'
  'ggml-vulkan: Vulkan kernels for llama-cpp, vendor-neutral'
  'xdg-desktop-portal: consent and app identity for sandboxed apps'
)
backup=('etc/ai-daemon/config.toml')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')
options=('!lto')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --workspace
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --release --workspace
}

package() {
  cd "$pkgname-$pkgver"

  # Commands a person runs.
  install -Dm755 target/release/ai-daemon      "$pkgdir/usr/bin/ai-daemon"
  install -Dm755 target/release/aidctl         "$pkgdir/usr/bin/aidctl"
  install -Dm755 target/release/ai-daemon-shim "$pkgdir/usr/bin/ai-daemon-shim"
  # On PATH, unlike the other helpers: this one is meant to be typed, and the
  # whole argument is that confining an application should be one command.
  install -Dm755 target/release/ai-run         "$pkgdir/usr/bin/ai-run"

  # Private helpers. Not on $PATH, because they are not commands: one has a
  # network and no prompts, the other parses hostile bytes in a cage, and
  # neither is useful to invoke by hand.
  install -Dm755 target/release/ai-daemon-fetch  "$pkgdir/usr/lib/$pkgname/ai-daemon-fetch"
  install -Dm755 target/release/ai-daemon-decode "$pkgdir/usr/lib/$pkgname/ai-daemon-decode"
  # The portal runs as the user rather than as a service account, but it is
  # still not a command anybody types: it is started by the session, or by the
  # session bus when an app first asks for it.
  install -Dm755 target/release/ai-daemon-portal "$pkgdir/usr/lib/$pkgname/ai-daemon-portal"

  # Provider plugins.
  install -Dm755 target/release/ai-daemon-backend-llamacpp \
    "$pkgdir/usr/lib/$pkgname/backends/ai-daemon-backend-llamacpp"
  install -Dm755 target/release/ai-daemon-backend-mock \
    "$pkgdir/usr/lib/$pkgname/backends/ai-daemon-backend-mock"
  # Not started, not configured. Its unit has ConditionPathExists on a file
  # this package does not install, so shipping the binary turns nothing on.
  install -Dm755 target/release/ai-daemon-backend-remote \
    "$pkgdir/usr/lib/$pkgname/backends/ai-daemon-backend-remote"

  # systemd.
  install -Dm644 packaging/systemd/ai-daemon.service \
    "$pkgdir/usr/lib/systemd/system/ai-daemon.service"
  install -Dm644 packaging/systemd/ai-daemon-fetch@.service \
    "$pkgdir/usr/lib/systemd/system/ai-daemon-fetch@.service"
  install -Dm644 packaging/systemd/ai-daemon-shim.service \
    "$pkgdir/usr/lib/systemd/system/ai-daemon-shim.service"
  install -Dm644 packaging/systemd/ai-daemon-backend-remote.service \
    "$pkgdir/usr/lib/systemd/system/ai-daemon-backend-remote.service"
  # A user unit, because it must run as the person whose apps it speaks for.
  install -Dm644 packaging/systemd/ai-daemon-portal.service \
    "$pkgdir/usr/lib/systemd/user/ai-daemon-portal.service"

  # sysusers.d and tmpfiles.d are processed by pacman's systemd hooks, so the
  # ai-daemon user, the ai group and the model store all exist after install
  # without this package running a script.
  install -Dm644 packaging/sysusers.d/ai-daemon.conf \
    "$pkgdir/usr/lib/sysusers.d/$pkgname.conf"
  install -Dm644 packaging/tmpfiles.d/ai-daemon.conf \
    "$pkgdir/usr/lib/tmpfiles.d/$pkgname.conf"

  # D-Bus: the bus policy, and the activation file that starts the daemon on
  # first use rather than at boot.
  install -Dm644 packaging/dbus/io.github.agraves.AIDaemon1.conf \
    "$pkgdir/usr/share/dbus-1/system.d/io.github.agraves.AIDaemon1.conf"
  install -Dm644 packaging/dbus/io.github.agraves.AIDaemon1.service \
    "$pkgdir/usr/share/dbus-1/system-services/io.github.agraves.AIDaemon1.service"
  # Session bus, not system: the portal belongs to a login session.
  install -Dm644 packaging/dbus/io.github.agraves.AIPortal1.service \
    "$pkgdir/usr/share/dbus-1/services/io.github.agraves.AIPortal1.service"

  # polkit: the consent actions, and the one narrow rule that lets the daemon
  # start its own download helper (the daemon has no network of its own).
  install -Dm644 packaging/polkit/io.github.agraves.aidaemon.policy \
    "$pkgdir/usr/share/polkit-1/actions/io.github.agraves.aidaemon.policy"
  install -Dm644 packaging/polkit/50-ai-daemon-fetch.rules \
    "$pkgdir/usr/share/polkit-1/rules.d/50-ai-daemon-fetch.rules"

  install -Dm644 packaging/config/config.toml "$pkgdir/etc/ai-daemon/config.toml"
  install -dm755 "$pkgdir/etc/ai-daemon/config.toml.d"
  # An example, not a config: the remote backend's unit will not start until
  # somebody copies this to remote.toml, which is the deliberate act that
  # sending prompts off this machine should be.
  install -Dm644 packaging/config/remote.toml.example \
    "$pkgdir/usr/share/doc/$pkgname/remote.toml.example"
  # Same treatment: documentation, not configuration. Without it every HTTP
  # caller shares one identity, which is how the shim behaved before it.
  install -Dm644 packaging/config/shim.toml.example \
    "$pkgdir/usr/share/doc/$pkgname/shim.toml.example"
  # Also an example, and for the same reason: under WSL2 the accelerator is
  # /dev/dxg rather than /dev/dri and PrivateDevices has to come off to reach
  # it. That is a real loosening of this unit and it buys nothing on hardware
  # that has a /dev/dri, so it ships as something to read and copy rather than
  # as a drop-in that would apply everywhere.
  install -Dm644 packaging/systemd/wsl.conf.example \
    "$pkgdir/usr/share/doc/$pkgname/wsl.conf.example"

  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 docs/protocol.md "$pkgdir/usr/share/doc/$pkgname/protocol.md"
  install -Dm644 docs/provisioning.md "$pkgdir/usr/share/doc/$pkgname/provisioning.md"
  install -Dm644 packaging/config/waybar.jsonc.example \
    "$pkgdir/usr/share/doc/$pkgname/waybar.jsonc.example"
  # The client story, installed where a person can copy it from: the whole
  # native protocol as a program, not a framing spec.
  install -Dm644 examples/think.py "$pkgdir/usr/share/doc/$pkgname/examples/think.py"
  install -Dm644 packaging/portal/org.freedesktop.portal.AI.xml \
    "$pkgdir/usr/share/doc/$pkgname/org.freedesktop.portal.AI.xml"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
